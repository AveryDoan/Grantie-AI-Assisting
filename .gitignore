__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Supabase local
supabase/.branches/
supabase/.temp/

# OS / editors
.DS_Store
.vscode/
.idea/

# Frontend
node_modules/
frontend/dist/

# Local redaction sandbox: real documents and their outputs must never be committed
sandbox/input/
sandbox/output/

# Dependencies and local environments
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
**/*.pyc

# Test and tool caches
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/

# Frontend build output
**/dist/
**/.vite/

# Local configuration and secrets
**/.env
**/.env.local
**/.env.*.local
!.env.example

# Operating-system files
.DS_Store
**/.DS_Store

# Runtime data and local databases
**/*.db
**/*.sqlite
**/*.sqlite3
# Local folder aliases retained outside the canonical package layout
Avery - Archived/
Grantie - Final/
