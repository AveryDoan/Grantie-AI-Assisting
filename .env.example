# Copy to .env and fill in. Never commit .env.

# supabase (default) | demo (in-memory synthetic data + demo login; local use only)
APP_MODE=supabase

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-side only. Bypasses RLS. Never expose to a browser or commit it.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Postgres connection for applying migrations (admin only, never used by the app or browser).
# Use the Session pooler string from Dashboard > Connect (the direct db.* host is IPv6-only).
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
# Only for projects still on the legacy shared JWT secret (HS256). Leave blank otherwise.
SUPABASE_JWT_SECRET=

# --- LLM ------------------------------------------------------------------
# gemini (default) | groq | stub (offline keyword matcher, NOT an LLM)
LLM_PROVIDER=gemini
# groq | none - used when the primary provider stays rate-limited
LLM_FALLBACK_PROVIDER=none
# Google AI Studio key
GEMINI_API_KEY=
# Model names change: check Google AI Studio for a current Flash-class model.
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=
# 0.0 - 0.2 only (enforced)
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RATE_LIMIT_RETRIES=4
LLM_CACHE_ENABLED=true
# Days to keep cached LLM outputs (blank = keep until expires_at)
LLM_RETENTION_DAYS=30

# --- Pipeline -------------------------------------------------------------
QUOTE_FUZZY_THRESHOLD=92
NAME_MATCH_THRESHOLD=85
CONSISTENCY_CHECK=false

# --- API ------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_ASSESS_PER_MINUTE=6
# JSON list, e.g. ["http://localhost:5173"]
CORS_ORIGINS=[]

# --- Seed -----------------------------------------------------------------
# Password for the demo login users created by `python -m seed.run`
SEED_DEMO_PASSWORD=

# --- Redaction ------------------------------------------------------------
# 32-byte key, base64, for encrypting token-map originals (AES-256-GCM).
# Generate with: python -m redaction.crypto   Never commit it.
REDACTION_KEY=
# Set to the old key while rotating, so existing rows still decrypt.
REDACTION_KEY_PREVIOUS=
